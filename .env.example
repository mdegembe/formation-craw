# ---------------------------------------------------------------------------
# Environnement applicatif
# ---------------------------------------------------------------------------
APP_ENV=production          # production | development
APP_DEBUG=false
APP_URL=https://formation.cra.wallonie.be
APP_TIMEZONE=Europe/Brussels
APP_LOCALE=fr_BE

# Cle secrete : signature des jetons. Generer avec :
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ---------------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------------
# sqlite (aucune configuration) ou mysql (production)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=craw_formation
DB_USER=craw
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Envoi de courriels
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=smtp         # smtp | mail | log
MAIL_HOST=smtp.cra.wallonie.be
MAIL_PORT=587
MAIL_ENCRYPTION=tls         # tls | ssl | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=formation@cra.wallonie.be
MAIL_FROM_NAME="CRA-W - Formations"
MAIL_REPLY_TO=formation@cra.wallonie.be

# ---------------------------------------------------------------------------
# Taches planifiees
# ---------------------------------------------------------------------------
# Jeton exige pour declencher le cron via HTTP (/cron/{token}).
CRON_TOKEN=

# ---------------------------------------------------------------------------
# Diplomes
# ---------------------------------------------------------------------------
# Taux de presence minimal pour l'obtention du diplome (0.80 = 80 %).
# Egalement modifiable depuis le back-office.
DIPLOMA_MIN_ATTENDANCE=0.80
